# ============================================================
# kiwi-mem 环境变量配置
# ============================================================
# 复制此文件为 .env 并填入你的值
# cp .env.example .env

# ---- 必填 ----

# LLM API Key（OpenRouter / OpenAI / AIHubMix / 其他兼容 OpenAI 格式的服务商）
API_KEY=sk-your-api-key-here

# LLM API 地址
API_BASE_URL=https://openrouter.ai/api/v1/chat/completions

# ---- Docker Compose 用户可以跳过以下配置 ----
# docker compose up 会自动创建数据库并连接，无需手动配置 DATABASE_URL

# PostgreSQL 连接串（仅手动部署时需要填写）
# DATABASE_URL=postgresql://user:password@localhost:5432/kiwi_mem

# ---- 可选 ----

# 记忆系统开关（docker compose 默认开启）
MEMORY_ENABLED=true

# 完整聊天原文归档（高敏感，需显式开启）
CHAT_ARCHIVE_ENABLED=false
# Docker 默认只绑定本机；用 Tailscale 时可改成一号机的 Tailscale IP。
KIWI_BIND_IP=127.0.0.1

# ---- 管理控制面认证 ----
# 先生成一段长随机原始密钥，原始值只交给浏览器；这里只填写它的 SHA-256 摘要。
# 生成摘要：python -c "import getpass,hashlib; print(hashlib.sha256(getpass.getpass('secret: ').encode()).hexdigest())"
KIWI_ADMIN_TOKEN_SHA256=replace-with-64-character-sha256-hex-digest

# ---- 共享身份入口（/memory/v1/*、聊天网关、MCP）----
# 身份与记忆空间由服务端固定；不同密钥只代表不同入口。
MEMORY_ASSISTANT_ID=grey_knox
MEMORY_SPACE_ID=zhizhi_grey
# 请为每个入口生成不同的长随机原始密钥，只把各自 SHA-256 摘要交给服务端。
# 客户端以原始密钥作为 Bearer token；入口名只用于内部审计，不进入记忆叙述。
# 原始密钥分别注入对应客户端，不得写入本文件或提交到 Git。
MEMORY_CLIENT_KEY_DIGESTS_JSON={"codex_vps2":"replace-with-64-character-sha256-hex-digest","cc_vps1":"replace-with-another-64-character-sha256-hex-digest","cc_vps2":"replace-with-a-third-64-character-sha256-hex-digest"}

# 默认聊天模型
DEFAULT_MODEL=anthropic/claude-sonnet-4

# 网关端口
PORT=8080

# 每次注入的最大记忆条数
MAX_MEMORIES_INJECT=15

# 记忆提取间隔（每 N 轮对话提取一次）
MEMORY_EXTRACT_INTERVAL=3

# 前端域名白名单（逗号分隔，CORS 用）
CORS_ORIGINS=*

# jieba 自定义分词词汇（逗号分隔，适合添加人名、专有名词）
JIEBA_CUSTOM_WORDS=

# OpenRouter 需要的额外请求头
EXTRA_REFERER=https://kiwi-mem.local
EXTRA_TITLE=kiwi-mem
